# demo 不调用付费模型或外部天气/地图 API；live 使用真实服务。
APP_MODE=demo
DASHSCOPE_API_KEY=
MODEL=qwen-plus
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENWEATHER_API_KEY=
AMAP_API_KEY=
# 当前高德官方推荐 streamable_http；旧 SSE 接入可自行配置。
AMAP_TRANSPORT=streamable_http
AMAP_MCP_URL=https://mcp.amap.com/mcp
OUTPUT_DIR=output
REQUEST_TIMEOUT=90
MAX_SESSIONS=100
MAX_TURNS=30
# 可选：配置后 CLI 需同样设置，网页启动时输入；不要将服务无鉴权公开。
APP_API_TOKEN=
